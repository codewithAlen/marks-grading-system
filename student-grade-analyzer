# Student Grade Analyzer

marks = []

n = int(input(f"Enter number of subjects: "))

for i in range(n):
    mark = int(input("Enter marks for subject {i+1}: "))
    marks.append(mark)

total = sum(marks)
average = total / n
highest = max(marks)
lowest = min(marks)

print("\n--- Result ---")
print("Total Marks:", total)
print("Average Marks:", average)
print("Highest Marks:", highest)
print("Lowest Marks:", lowest)

# Grade Calculation
if average >= 90:
    grade = "A"
elif average >= 75:
    grade = "B"
elif average >= 60:
    grade = "C"
else:
    grade = "D"

print("Grade:", grade)
